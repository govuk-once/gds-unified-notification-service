{
  "name": "gds-unified-notification-service",
  "version": "0.0.0",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:validate": "tsc",
    "checkov": "checkov --config-file .checkov.yaml --directory infrastructure/cdk/cdk.out/ --framework cloudformation --compact --quiet",
    "development:sandbox:release": "pnpm run build && pnpm run cdk:deploy",
    "development:sandbox:plan": "pnpm run build && pnpm run cdk:diff",
    "development:sandbox:setup": "tsx scripts/developer-sandbox-setup.ts",
    "cdk": "cd infrastructure/cdk && cdk",
    "cdk:diff": "pnpm run cdk diff",
    "cdk:synth": "rm -rf infrastructure/cdk/cdk.out && pnpm run cdk synth",
    "cdk:deploy": "pnpm run cdk:predeploy:ssm && pnpm run cdk deploy --require-approval never --import-existing-resources true --all && pnpm run cdk:postdeploy:ssm",
    "cdk:postdeploy:ssm": "cd infrastructure/cdk && tsx cdk.postdeploy.ssm.ts",
    "cdk:predeploy:ssm": "cd infrastructure/cdk && tsx cdk.predeploy.ssm.ts",
    "lint:fix": "eslint . --fix && prettier . --write",
    "lint": "eslint . --cache --cache-location .eslintcache --concurrency=auto --stats && prettier . --check --cache --cache-location",
    "pre-commit": "tsx scripts/pre-commit.ts",
    "prepare": "husky",
    "semantic:release": "semantic-release",
    "test:coverage": "vitest run --coverage --project unit",
    "test:coverage:detailed": "VITEST_DETAILED_COVERAGE=true vitest run --coverage --project unit",
    "test": "vitest",
    "test:report:generate": "rm -rf html && env=dev VITEST_HTML_REPORT=true npm run test",
    "test:report:review": "npx vite preview --outDir html",
    "test:unit": "vitest --project unit",
    "test:e2e": "vitest --project e2e",
    "test:ui": "vitest --ui --coverage --project unit",
    "upgrade": "ncu -u -d 'pnpm run test:unit' && pnpm audit --omit dev",
    "upgrade:diff": "ncu -x @eslint/js -x eslint-plugin-markdownlint -x eslint-plugin-prettier"
  },
  "devDependencies": {
    "@aws-sdk/client-api-gateway": "^3.1110.0",
    "@aws-sdk/client-s3": "^3.1110.0",
    "@aws-sdk/client-sqs": "^3.1100.0",
    "@aws-sdk/client-sts": "^3.1110.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-angular": "^21.2.2",
    "@eslint/js": "^9.39.1",
    "@inquirer/prompts": "^8.0.2",
    "@semantic-release/exec": "^7.1.0",
    "@types/archiver": "^7.0.0",
    "@types/aws-lambda": "^8.10.159",
    "@types/http-errors": "^2.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.0.3",
    "@types/node-forge": "^1.3.14",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^4.1.9",
    "aws-cdk": "^2.1136.0",
    "aws-cdk-lib": "2.265.0",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-vitest": "^7.0.1",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-markdownlint": "^0.10.1",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "msw": "^2.14.6",
    "npm": "^11.16.0",
    "npm-check-updates": "^21.0.1",
    "once-platform-constructs": "^1.2.0",
    "prettier": "3.9.6",
    "semantic-release": "^25.0.8",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "undici": "^6.26.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-lambda-powertools/batch": "^2.34.0",
    "@aws-lambda-powertools/jmespath": "^2.34.0",
    "@aws-lambda-powertools/logger": "^2.34.0",
    "@aws-lambda-powertools/metrics": "^2.34.0",
    "@aws-lambda-powertools/parameters": "^2.34.0",
    "@aws-lambda-powertools/parser": "^2.34.0",
    "@aws-lambda-powertools/tracer": "^2.34.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1110.0",
    "@aws-sdk/client-secrets-manager": "^3.1110.0",
    "@aws-sdk/client-ssm": "^3.1110.0",
    "@aws-sdk/core": "^3.977.7",
    "@aws-sdk/credential-providers": "^3.1110.0",
    "@aws-sdk/util-dynamodb": "^3.996.8",
    "@aws-sdk/util-format-url": "^3.972.44",
    "@middy/core": "^7.7.3",
    "@middy/http-error-handler": "^6.4.5",
    "@middy/http-event-normalizer": "^6.4.5",
    "@middy/http-header-normalizer": "^6.4.5",
    "@middy/http-json-body-parser": "^6.4.5",
    "@middy/http-urlencode-body-parser": "^6.4.5",
    "@middy/secrets-manager": "^6.4.5",
    "@smithy/hash-node": "^4.5.0",
    "@smithy/protocol-http": "^5.6.0",
    "@smithy/signature-v4": "^5.7.0",
    "aws-xray-sdk-core": "^3.12.0",
    "http-errors": "^2.0.1",
    "markdown-it": "^14.2.0",
    "node-forge": "^1.4.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.62.4"
  },
  "packageManager": "pnpm@11.9.0"
}
